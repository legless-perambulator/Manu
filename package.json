{
  "name": "jellytind",
  "version": "0.0.0",
  "private": true,
  "description": "AI-native fiction development environment (monorepo root).",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @jellytind/desktop dev",
    "dev:desktop": "pnpm --filter @jellytind/desktop tauri:dev",
    "build": "pnpm run typecheck && pnpm --filter @jellytind/desktop build",
    "build:desktop": "pnpm --filter @jellytind/desktop tauri:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @jellytind/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:fixture": "vitest run --config vitest.fixture.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run lint:rust && pnpm run test:rust",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "lint:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
