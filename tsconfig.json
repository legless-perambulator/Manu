{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/providers/*/src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
